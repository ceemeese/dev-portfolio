---
import GitIcon from './svg/GitIcon.astro';

interface Props {
    className: string;
    title: string;
    description: string;
    images: string[];
    links: { label: string; url: string }[];
}

const { className, title, description, images, links } = Astro.props;
const hasSlider = images.length > 1;
---

<div class={`${className} card group max-w-full lg:max-w-lg py-2 rounded-2xl transition-transform duration-700 ease-in-out hover:scale-105`}>
    <div class="py-3">

        {hasSlider ? (
            <div data-slider class="relative overflow-hidden rounded-md w-full md:h-[350px] lg:h-[300px]">
                <div data-slider-track class="flex h-full transition-transform duration-500 ease-in-out">
                    {images.map(img => (
                        <img src={`/images/${img}.webp`} alt="" class="w-full flex-shrink-0 object-cover h-full" />
                    ))}
                </div>
                <button data-prev class="absolute left-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-black/40 text-white flex items-center justify-center text-lg leading-none hover:bg-black/65 transition-colors" aria-label="Anterior">‹</button>
                <button data-next class="absolute right-2 top-1/2 -translate-y-1/2 w-7 h-7 rounded-full bg-black/40 text-white flex items-center justify-center text-lg leading-none hover:bg-black/65 transition-colors" aria-label="Siguiente">›</button>
                <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
                    {images.map((_, i) => (
                        <button data-dot class="w-1.5 h-1.5 rounded-full bg-white transition-opacity" style={i === 0 ? "opacity:1" : "opacity:0.4"} aria-label={`Imagen ${i + 1}`} />
                    ))}
                </div>
            </div>
        ) : (
            <div class="overflow-hidden rounded-md w-full">
                <img src={`/images/${images[0]}.webp`} alt="" class="rounded-md md:h-[350px] lg:h-[300px] object-cover w-full transition-transform duration-500" />
            </div>
        )}

        <div class="py-2">
            <h3 class="text-base md:text-xl font-normal text-dark dark:text-primary transition-colors duration-300 group-hover:text-secondary">{title}</h3>
            <div class="flex flex-wrap gap-1.5 mt-1.5">
                {links.map(link => (
                    <a
                        href={link.url}
                        target="_blank"
                        class="flex items-center gap-1.5 text-xs text-gray-500 dark:text-primary border border-gray-300 dark:border-gray-600 rounded-full px-2.5 py-0.5 hover:text-secondary hover:border-secondary transition-colors"
                    >
                        <GitIcon className="w-3 h-3" />
                        {link.label && <span>{link.label}</span>}
                    </a>
                ))}
            </div>
            <div class="py-2">
                <p class="text-gray-500 dark:text-primary text-wrap font-light">{description}</p>
            </div>
        </div>

        <div class="flex flex-wrap gap-2 transform translate-y-2 text-black">
            <slot name="tags" />
        </div>
    </div>
</div>


<script>
    import { animate, onScroll } from 'animejs';

    document.addEventListener("DOMContentLoaded", () => {
        const cards = document.querySelectorAll('.card');
        cards.forEach((card, index) => {
            animate(card, {
                opacity: [0, 1],
                duration: 400,
                delay: index * 100,
                ease: 'out-cubic',
                autoplay: onScroll({
                    target: card,
                    axis: 'y',
                    enter: 'bottom 30%',
                })
            });
        });

        document.querySelectorAll('[data-slider]').forEach(slider => {
            const track = slider.querySelector('[data-slider-track]') as HTMLElement;
            const dots  = slider.querySelectorAll('[data-dot]') as NodeListOf<HTMLElement>;
            const total = track.children.length;
            let current = 0;

            function goTo(n: number) {
                current = (n + total) % total;
                track.style.transform = `translateX(-${current * 100}%)`;
                dots.forEach((d, i) => {
                    d.style.opacity = i === current ? '1' : '0.4';
                });
            }

            slider.querySelector('[data-prev]')?.addEventListener('click', e => {
                e.preventDefault();
                e.stopPropagation();
                goTo(current - 1);
            });

            slider.querySelector('[data-next]')?.addEventListener('click', e => {
                e.preventDefault();
                e.stopPropagation();
                goTo(current + 1);
            });

            dots.forEach((dot, i) => {
                dot.addEventListener('click', e => {
                    e.preventDefault();
                    e.stopPropagation();
                    goTo(i);
                });
            });
        });
    });
</script>
